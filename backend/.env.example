# 이 파일을 복사해 .env 로 만들고 값을 채운다. (.env 는 Git에 올라가지 않음)

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 코디세이 중계 서버 (공식 OpenAI 키면 비워둠)
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
# 선택: 출력 토큰 상한 / 추론 강도(코디세이 서버는 미지원 -> 비움) / GPT에 보낼 이전 메시지 수
OPENAI_MAX_TOKENS=1500
OPENAI_REASONING_EFFORT=
CHAT_HISTORY_LIMIT=10

# Firebase 서비스 계정 — 둘 중 하나만 설정
#  - 로컬: 키 파일 경로 (역슬래시 대신 / 사용)
FIREBASE_SERVICE_ACCOUNT_PATH=C:/keys/your-service-account.json
#  - Render: 키 JSON 전체를 한 줄 문자열로
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS 허용 도메인 (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
